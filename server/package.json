{
  "name": "ufon-weddings-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ufon Weddings API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "export:data": "node dist/export-static.js",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts"
  },
  "dependencies": {
